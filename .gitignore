data/
# artifacts: data, features, models and predictions stay local; small result files (tables, freeze manifest,
# per-branch params, metrics, costs, importances) are tracked so the README links resolve
artifacts/**
!artifacts/**/
!artifacts/*.md
!artifacts/*.json
!artifacts/*.txt
!artifacts/kion/*.md
!artifacts/kion/*.json
!artifacts/x5/*.md
!artifacts/x5/*.json
!artifacts/**/runs/*/*.json
!artifacts/**/runs/*/importance_*.csv
.venv/
__pycache__/
*.pyc
.pytest_cache/
# Perseus clone, caches and run outputs stay local; our adapter, env script and the CUDA patch are tracked
external/*
!external/perseus_adapter/
external/perseus_adapter/*
!external/perseus_adapter/*.py
!external/probe_env.ps1
!external/probe_runtime.py
!external/perseus_cu126.patch

logs/*
src/*.egg-info/

# Local tool settings and work notes
.claude/
.codex/
.cursor/
.agents/
AGENTS.md
CLAUDE.md
**/SKILL.md

# Published provenance and file checksums
!artifacts/publication/*.json
